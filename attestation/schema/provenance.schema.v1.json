{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/kidjack44-svg/qrap-demo/attestation/schema/provenance.schema.v1.json",
  "title": "QRAP Demo Provenance Attestation",
  "description": "Schema for provenance attestations documenting how qrap-demo artifacts were built",
  "type": "object",
  "required": ["subject", "build"],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Reference to this schema"
    },
    "subject": {
      "type": "object",
      "description": "The artifact this provenance describes",
      "required": ["name", "type"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Name of the artifact (e.g., qrap-demo, qrap-core)"
        },
        "type": {
          "type": "string",
          "enum": ["container-image", "wasm-module", "python-wheel", "binary", "source-archive"],
          "description": "Type of artifact"
        },
        "digest": {
          "type": "object",
          "description": "Cryptographic digest(s) of the artifact",
          "properties": {
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "sha512": {
              "type": "string",
              "pattern": "^[a-f0-9]{128}$"
            }
          }
        }
      }
    },
    "build": {
      "type": "object",
      "description": "Build provenance information",
      "required": ["source_repo", "commit", "timestamp"],
      "properties": {
        "source_repo": {
          "type": "string",
          "format": "uri",
          "description": "URL of the source repository"
        },
        "commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$",
          "description": "Full 40-character git commit SHA"
        },
        "branch": {
          "type": "string",
          "description": "Branch name (if applicable)"
        },
        "tag": {
          "type": "string",
          "description": "Git tag (if applicable)"
        },
        "workflow": {
          "type": "string",
          "description": "Name or identifier of the build workflow"
        },
        "workflow_run_id": {
          "type": "string",
          "description": "CI workflow run identifier"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp of the build"
        },
        "builder": {
          "type": "object",
          "description": "Information about the build environment",
          "properties": {
            "id": {
              "type": "string",
              "description": "Builder identifier (e.g., GitHub Actions)"
            },
            "version": {
              "type": "string",
              "description": "Builder version"
            }
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "description": "Additional metadata",
      "properties": {
        "buildInvocationId": {
          "type": "string"
        },
        "completeness": {
          "type": "object",
          "properties": {
            "parameters": {
              "type": "boolean"
            },
            "environment": {
              "type": "boolean"
            },
            "materials": {
              "type": "boolean"
            }
          }
        },
        "reproducible": {
          "type": "boolean"
        }
      }
    }
  }
}
